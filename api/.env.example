APP_NAME=Gather
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Lets `php artisan serve` handle requests in parallel (the SPA fires several at once).
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite by default (database/database.sqlite). For MySQL or PostgreSQL, set these instead.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=gather
# DB_USERNAME=root
# DB_PASSWORD=

# The API is stateless (bearer tokens), so it needs no sessions.
SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# Comma-separated origins allowed to call the API from a browser (the Vue SPA).
CORS_ALLOWED_ORIGINS=http://localhost:5173
